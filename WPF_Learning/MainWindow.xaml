<Window x:Class="WPF_Learning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Learning"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="ProductGrid" HorizontalAlignment="Left" Height="175" Margin="178,42,0,0" VerticalAlignment="Top" Width="612" d:ItemsSource="{d:SampleData ItemCount=5}" Visibility="Hidden"/>
        <Button Content="Add to cart" HorizontalAlignment="Left" Margin="40,0,0,0" VerticalAlignment="Center" Height="40" Width="90"/>
        <Button Content="Order" Margin="40,291,670,103" Click="Button_Click"/>
        <DataGrid x:Name="CartGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="178,238,10,10"/>
        <Button x:Name="btnTestLogic" Content="Login" HorizontalAlignment="Center" Margin="0,287,0,0" VerticalAlignment="Top" Height="39" Width="90" Click="btnTestLogic_Click"/>
        <TextBox x:Name="txtUsername" TextWrapping="Wrap" Margin="327,103,327,278"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Center" VerticalAlignment="Center" Width="146" Height="39"/>

    </Grid>
</Window>
