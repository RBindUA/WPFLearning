<Window x:Class="WPF_Learning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Learning"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-16">
        <DataGrid x:Name="CatalogGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="178,130,10,160"/>
        <DataGrid x:Name="HistoryGrid" Height="103" Margin="178,0,10,0" VerticalAlignment="Top" d:ItemsSource="{d:SampleData ItemCount=5}" Visibility="Visible"/>
        <Button x:Name="btnAddToCart" Content="Add to cart" Margin="0,213,710,181" Click="btnAddToCart_Click" HorizontalAlignment="Right" Width="90"/>
        <Button x:Name="btnOrder" Content="Order" Margin="0,331,710,63" Click="btnPlaceOrder_Click" HorizontalAlignment="Right" Width="90"/>
        <DataGrid x:Name="CartGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="178,287,10,0"/>
        <Button x:Name="btnTestLogic" Content="Login" Margin="355,287,355,108" Click="btnTestLogic_Click"/>
        <TextBox x:Name="txtUsername" TextWrapping="Wrap" Margin="327,103,327,278"/>
        <PasswordBox x:Name="txtPassword" Margin="327,198,327,197"/>

    </Grid>
</Window>
