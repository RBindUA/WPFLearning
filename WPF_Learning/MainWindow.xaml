<Window x:Class="WPF_Learning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Learning"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="10">
            <!-- LEFT -->
            <StackPanel Width="150" Margin="0,0,20,0">
                <StackPanel Margin="0,0,0,20">
                    <TextBox x:Name="txtUsername" TextWrapping="Wrap" Height="50" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="40" Margin="0,0,0,10"/>
                    <Button x:Name="btnTestLogic" Content="Login" Height="40" Click="btnTestLogic_Click"/>
                </StackPanel>
                
                <Button x:Name="btnAddToCart" Content="Add to cart" Height="40" Margin="0,0,0,10" Click="btnAddToCart_Click"/>
                <Button x:Name="btnOrder" Content="Order" Height="40" Click="btnPlaceOrder_Click"/>
            </StackPanel>

            <!-- RIGHT -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                <DataGrid x:Name="HistoryGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Width="Auto" Height="84" Margin="0,0,0,10"/>
                <DataGrid x:Name="CatalogGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Width="Auto" Height="144" Margin="0,0,0,10"/>
                <DataGrid x:Name="CartGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Width="Auto" Height="196"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
